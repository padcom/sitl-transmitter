// The command line (section 4 of the plan), read by pico-commander: flags -> Options, with every range checked, the help text, and
// the exit code of a refusal (2 for a usage error, 4 for a start that is refused: not interactive and no --go). Pure: no I/O, no exit
// (commander's output is caught and handed back in `Parsed.message`).
import { Command, CommanderError, InvalidArgumentError, Option, Parser, Value, Values } from "padcom/commander"
import { NAME, versionLine } from "./version"

/// Everything the command line can say.
export class Options {
  public list: bool = false
  /// The `--pad` text: "" for the only pad.
  public pad: string = ""
  public instance: int = 0
  /// The explicit `--port`, or -1.
  public port: int = -1
  public host: string = "127.0.0.1"
  public rate: int = 50
  public offset: int = 0
  /// The RC channels of roll, pitch, throttle, yaw.
  public sticks: int[] = [1, 2, 3, 4]
  public throttleLow: bool = false
  public rudderArm: bool = false
  public go: bool = false
  public fakePad: string = ""
  /// Seconds to run, or -1 for no limit.
  public exitAfter: int = -1
  public quiet: bool = false
  public verbose: bool = false

  /// The UDP port: the explicit one, else 5501 + 10 for each instance.
  public portOf(): int {
    return if (port >= 0) port else 5501 + 10 * instance
  }
}

/// What the command line came to: an action (`run`, `list`, `help`, `version`, or `error` with an exit code), the text to show (the
/// help or the version for stdout, the error for stderr; without its last line break) and the options.
export class Parsed {
  public action: string = "run"
  public code: int = 0
  public message: string = ""
  public options: Options = new Options()
}

/// A whole number written in digits (no sign, no spaces), or -1 for anything else.
export function digits(text: string): int {
  if (text.length == 0 || text.length > 9) {
    return -1
  }
  let n = 0
  for (let i = 0; i < text.length; i++) {
    const digit = "0123456789".indexOf(text.slice(i, i + 1))
    if (digit < 0) {
      return -1
    }
    n = n * 10 + digit
  }
  return n
}

/// Why an address is not one to send to, or "": a broadcast, a multicast or the "any" address of IPv4 written out, and IPv6. (A name is
/// checked again after it was resolved: `addressProblem`.)
export function addressProblem(address: string): string {
  if (address.includes(":")) {
    return "an IPv6 address: use an IPv4 address or a name"
  }
  const parts = address.split(".")
  if (parts.length != 4) {
    return ""
  }
  const first = digits(parts[0])
  if (address == "255.255.255.255") {
    return "the broadcast address: name the host that runs SITL"
  }
  if (address == "0.0.0.0") {
    return "the address 0.0.0.0: name the host that runs SITL"
  }
  if (first >= 224 && first <= 239) {
    return "a multicast address: name the host that runs SITL"
  }
  return ""
}

/// The `--sticks` list: the channels 1..16 it names, or [] when one is not.
function sticksOf(text: string): int[] {
  const out: int[] = []
  const parts = text.split(",")
  for (let i = 0; i < parts.length; i++) {
    const n = digits(parts[i].trim())
    if (n < 1 || n > 16) {
      return []
    }
    out.push(n)
  }
  return out
}

function hasDuplicates(values: int[]): bool {
  for (let i = 0; i < values.length; i++) {
    for (let j = i + 1; j < values.length; j++) {
      if (values[i] == values[j]) {
        return true
      }
    }
  }
  return false
}

/// The highest SITL instance whose RC-in port (5501 + 10 n) is still a port: 5501 + 10 * 6003 = 65531.
const MAX_INSTANCE = 6003

/// A parser for a whole number from `low` to `high`, in digits.
function whole(low: int, high: int): Parser {
  return (value: string, _previous: Value?): Value => {
    const n = digits(value)
    if (n < low || n > high) {
      throw new InvalidArgumentError(`It wants a whole number from ${low} to ${high}.`)
    }
    return Value.Int(n)
  }
}

function host(value: string, _previous: Value?): Value throws Error {
  if (value.length == 0) {
    throw new InvalidArgumentError("No host.")
  }
  const problem = addressProblem(value)
  if (problem != "") {
    throw new InvalidArgumentError(`It is ${problem}.`)
  }
  return Value.Str(value)
}

function sticks(value: string, _previous: Value?): Value throws Error {
  const channels = sticksOf(value)
  if (channels.length != 4) {
    throw new InvalidArgumentError("It wants four RC channels from 1 to 16, like 1,2,3,4.")
  }
  if (hasDuplicates(channels)) {
    throw new InvalidArgumentError("It wants four different channels.")
  }
  return Value.Str(value)
}

/// Where commander writes: kept, to be handed back.
class Capture {
  public out: string = ""
  public err: string = ""
}

const DESCRIPTION = "Reads one gamepad or radio and sends its channels, as a receiver would, to ArduPilot SITL's UDP RC input (SITL only: never a vehicle)."

const AFTER = `
Ends with q + Enter (or Ctrl-C where the platform lets it).

Exit codes:
  0  normal end
  2  usage error
  3  no pad or no access to it
  4  the start was refused
  5  the UDP socket could not be made or the host not resolved`

/// The program's command line, writing to `capture`.
function program(capture: Capture): Command {
  return new Command()
    .name(NAME)
    .description(DESCRIPTION)
    .exitOverride()
    .configureOutput({
      writeOut: (s: string) => { capture.out += s },
      writeErr: (s: string) => { capture.err += s },
    })
    .showHelpAfterError(`(${NAME} --help lists the options)`)
    .option("--list", "list the pads (index, name, id, path, axes, buttons) and exit")
    .option("--pad <n|id|text>", "the list index, the exact id (1209:4f54) or a part of the name (default: the only pad)")
    .option("--instance <n>", `SITL instance (-I n), 0..${MAX_INSTANCE}: port = 5501 + 10 n, only where SITL derives its RC port from -I`, whole(0, MAX_INSTANCE), 0)
    .option("--port <p>", "UDP port 1024..65535; wins over --instance (default: 5501)", whole(1024, 65535))
    .option("--host <ip|name>", "where SITL runs, e.g. a virtual machine; resolved once at start", host, "127.0.0.1")
    .option("--rate <hz>", "send rate 10..100", whole(10, 100), 50)
    .option("--offset <n>", "channel offset 0..8: pad channel k goes to RC channel k + offset", whole(0, 8), 0)
    .option("--sticks <r,p,t,y>", "the RC channels of roll, pitch, throttle, yaw: the vehicle's RCMAP_*", sticks, "1,2,3,4")
    .addOption(new Option("--throttle-rest <rest>", "where the throttle rests").choices(["centre", "low"]).default("centre"))
    .option("--rudder-arm", "lift the yaw hold, so that the sticks can arm and disarm")
    .option("--go", "no \"press Enter\" (required when stdin is not a terminal)")
    .option("--fake-pad <file>", "read the pad from a script (JSON Lines) instead of a device")
    .option("--exit-after <s>", "end (after the neutral frame) after s seconds, 1..86400", whole(1, 86400))
    .option("--quiet", "no status line")
    .option("--verbose", "once a second, the first 8 channels of the last packet and how many were sent")
    .version(versionLine(), "--version", "print the name and the version")
    .helpOption("-h, --help", "show this help")
    .addHelpText("after", AFTER)
}

/// The help text, as `--help` shows it.
export function usage(): string {
  return parse(["--help"], true).message
}

/// The options commander read.
function optionsOf(opts: Values): Options {
  const options = new Options()
  options.list = opts.bool("list")
  options.pad = opts.string("pad") ?? ""
  options.instance = opts.int("instance") ?? 0
  options.port = opts.int("port") ?? -1
  options.host = opts.string("host") ?? "127.0.0.1"
  options.rate = opts.int("rate") ?? 50
  options.offset = opts.int("offset") ?? 0
  options.sticks = sticksOf(opts.string("sticks") ?? "1,2,3,4")
  options.throttleLow = opts.string("throttleRest") == "low"
  options.rudderArm = opts.bool("rudderArm")
  options.go = opts.bool("go")
  options.fakePad = opts.string("fakePad") ?? ""
  options.exitAfter = opts.int("exitAfter") ?? -1
  options.quiet = opts.bool("quiet")
  options.verbose = opts.bool("verbose")
  return options
}

/// Reads the arguments. `interactive` is whether stdin is a terminal: without one the start needs `--go`, else the start is refused
/// (code 4).
export function parse(args: string[], interactive: bool): Parsed {
  const capture = new Capture()
  const command = program(capture)
  const parsed = new Parsed()
  try {
    command.parse(args)
  } catch (e: CommanderError) {
    if (e.code == "commander.helpDisplayed") {
      parsed.action = "help"
      parsed.message = capture.out.trimEnd()
    } else if (e.code == "commander.version") {
      parsed.action = "version"
      parsed.message = capture.out.trimEnd()
    } else {
      parsed.action = "error"
      parsed.code = 2
      parsed.message = capture.err.trimEnd()
    }
    return parsed
  } catch (e: Error) {
    parsed.action = "error"
    parsed.code = 2
    parsed.message = `error: ${e.message}`
    return parsed
  }
  const options = optionsOf(command.opts())
  if (options.list) {
    parsed.action = "list"
  } else if (!interactive && !options.go) {
    parsed.action = "error"
    parsed.code = 4
    parsed.message = "stdin is not a terminal: there is nobody to press Enter. Start it with --go (it then sends as soon as the sticks are at rest)"
    return parsed
  }
  parsed.options = options
  return parsed
}
