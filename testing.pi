// Helpers for the tests: a clock the test moves, a TX16S-shaped layout, readings at rest, and the fakes the runner is run with (time that
// waits by moving, a sink that records frames, a place that collects what is said).
import { Layout } from "./channels"
import { Config, Machine, Reading } from "./gate"
import { Control, Out, Time } from "./runner"
import { Sink } from "./sender"

/// A clock in ms that only a test moves.
export class Clock {
  public now: int = 0

  public advance(ms: int): int {
    now += ms
    return now
  }
}

/// Time for the runner: `wait` only moves the clock, so a run of seconds takes no time. `at(ms, action)` lets a test act at a moment
/// (press Enter, unplug, quit): the action runs, once, in the first wait that reaches that time.
export class FakeTime implements Time {
  public ms: int = 0
  public waits: int = 0
  /// Every second wait lasts this many ms longer than asked (a scheduler that is late).
  public jitter: int = 0
  public whens: int[] = []
  public actions: (() => void)[] = []

  public at(when: int, action: () => void): void {
    whens.push(when)
    actions.push(action)
  }

  public now(): int {
    return ms
  }

  public async wait(delay: int): Promise<void> throws Error {
    waits += 1
    ms += delay + (if (jitter > 0 && waits % 2 == 1) jitter else 0)
    for (let i = 0; i < whens.length; i++) {
      if (whens[i] >= 0 && whens[i] <= ms) {
        whens[i] = -1
        actions[i]()
      }
    }
  }
}

/// A sink that records what it was given (and can be made to fail).
export class Recorder implements Sink {
  public frames: int[][] = []
  public at: int[] = []
  public broken: bool = false
  public time: FakeTime? = null

  public async send(frame: int[]): Promise<void> throws Error {
    if (broken) {
      throw new Error("network is unreachable")
    }
    frames.push(frame)
    const t = time
    at.push(if (t != null) t!.now() else 0)
  }

  public close(): void {}
}

/// What was said, in order.
export class Lines implements Out {
  public said: string[] = []

  public line(text: string): void {
    said.push(text)
  }

  public has(part: string): bool {
    for (const s of said) {
      if (s.includes(part)) {
        return true
      }
    }
    return false
  }
}

/// A control with nothing said.
export function quiet(): Control {
  return new Control()
}

/// A TX16S: 8 axes and 24 buttons (CH1..CH8 axes, CH9..CH16 buttons 0..7, the other buttons dropped).
export function radio(offset: int = 0): Layout {
  return new Layout(8, 24, offset)
}

/// `n` axes at the middle (0.0), the throttle (axis 2) at `throttle`.
export function axesAt(n: int, throttle: f64): f64[] {
  const axes: f64[] = []
  for (let i = 0; i < n; i++) {
    axes.push(if (i == 2) throttle else 0.0)
  }
  return axes
}

/// `n` buttons, all released.
export function released(n: int): bool[] {
  const buttons: bool[] = []
  for (let i = 0; i < n; i++) {
    buttons.push(false)
  }
  return buttons
}

/// A reading of a TX16S with the sticks at rest (the throttle in the middle) and every button released.
export function restingRadio(): Reading {
  return new Reading(axesAt(8, 0.0), released(24))
}

/// The usual config: a TX16S, the sticks on RC channels 1..4, the throttle resting in the middle, the yaw held.
export function config(throttleLow: bool = false, rudderArm: bool = false): Config {
  return new Config(radio(), [1, 2, 3, 4], throttleLow, rudderArm)
}

/// A machine that has seen its pad, been told go, and passed the gate (10 right reads): the next tick sends.
export function sendingMachine(clock: Clock, throttleLow: bool = false, rudderArm: bool = false): Machine {
  const machine = new Machine(config(throttleLow, rudderArm))
  machine.padOpened()
  machine.start()
  const rest = new Reading(axesAt(8, if (throttleLow) -1.0 else 0.0), released(24))
  for (let i = 0; i < 10; i++) {
    machine.tick(clock.advance(20), rest)
  }
  return machine
}
