// The version line, and that project.json agrees with it.
import { describe, it, expect } from "std/test"
import { readText } from "std/fs"
import { NAME, VERSION, versionLine } from "./version"

async function theVersionLineSaysTheNameAndTheVersion(): Promise<void> throws Error {
  expect(versionLine()).toBe("sitl-transmitter 0.0.1")
  expect(`${NAME} ${VERSION}`).toBe(versionLine())
}

async function projectJsonHasTheSameVersion(): Promise<void> throws Error {
  const text = await readText("project.json")
  expect(text.includes(`"version": "${VERSION}"`)).toBe(true)
  expect(text.includes(`"name": "padcom/${NAME}"`)).toBe(true)
}

describe("the version", () => {
  it("is named in one place", theVersionLineSaysTheNameAndTheVersion)
  it("is the one in project.json", projectJsonHasTheSameVersion)
})
